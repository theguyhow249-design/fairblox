{
  "name": "fairblox",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @fairblox/web\" \"npm run dev -w @fairblox/api\"",
    "build": "npm run build -w @fairblox/types && npm run build -w @fairblox/web && npm run build -w @fairblox/api",
    "preview": "npm run preview -w @fairblox/web",
    "start": "npm run start -w @fairblox/api"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
