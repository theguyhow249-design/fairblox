# Copy this file to .env and fill in the values.

# Required for persistent storage. Leave blank to use in-memory store (dev only).
DATABASE_URL=

# Port the API listens on. Defaults to 4000.
PORT=4000

# Discord webhook URL for alerts.
# Create one at: Server Settings → Integrations → Webhooks → New Webhook → Copy Webhook URL
# Leave blank to disable Discord alerts.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Optional: set to "production" in live deployments.
NODE_ENV=development

# Public frontend URL used for Stripe success/cancel redirects.
APP_BASE_URL=http://localhost:5173

# Public API URL used when creating Stripe Checkout sessions.
API_BASE_URL=http://localhost:4000

# Stripe secret key from the Stripe dashboard.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret.
STRIPE_WEBHOOK_SECRET=
